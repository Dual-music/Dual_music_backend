# ============================================================================
# DUAL MUSIC BACKEND — Environment variables (exhaustive)
# Copy to `.env` and fill. Boot fails fast if a REQUIRED variable is missing.
# ============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
# Comma-separated whitelist of allowed browser origins (frontend + mobile web).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=info

# --- Database (MySQL 8) ------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=duel_music
DB_NAME_TEST=duel_music_test
DB_USER=root
DB_PASSWORD=change_me

# --- Auth / JWT (RS256) ------------------------------------------------------
# PEM private/public keys. Use \n for newlines when inlining, or point to files.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_COST=12
# HMAC secret used to hash refresh tokens & OTP codes at rest.
TOKEN_HASH_SECRET=change_me_to_a_long_random_secret

# --- OTP (phone/email verification) -----------------------------------------
OTP_TTL_SECONDS=600
OTP_LENGTH=6
# SMS provider (leave empty in dev to log OTP to console via MailHog/logger).
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=DualMusic

# --- Redis (cache, rate-limit, sessions, BullMQ) ----------------------------
REDIS_URL=redis://127.0.0.1:6379
# When true, disables Redis-backed features and falls back to node-cron/in-memory.
REDIS_OPTIONAL=true

# --- Google OAuth ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/google/callback

# --- LiveKit -----------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Enregistrement serveur des directs (Egress -> R2/S3) pour les replays. Nécessite un
# service Egress LiveKit déployé + les creds S3 ci-dessous + le webhook LiveKit pointant
# vers POST /webhooks/livekit. Voir docs/RECORDING.md. Laisser à false tant que non provisionné.
LIVEKIT_EGRESS_ENABLED=false

# --- Payments: CinetPay (nouvelle API v1) ------------------------------------
# Compte marchand par défaut : api_key (sk_test_… en sandbox, sk_live_… en prod)
# + api_password. La base (sandbox api.cinetpay.net / prod api.cinetpay.co) est
# auto-détectée depuis le préfixe de la clé.
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
# Optionnel : forcer la base (sinon auto sk_test_/sk_live_).
CINETPAY_BASE_URL=
# Multi-pays (1 compte = 1 pays) : JSON { "CI": { "key": "...", "password": "..." }, "CM": {...} }.
# Laisse vide pour n'utiliser que le compte par défaut ci-dessus.
CINETPAY_ACCOUNTS=
# ⚠️ CinetPay filtre par IP : l'IP publique du backend doit être ajoutée à la
# liste blanche du compte marchand (sinon l'auth échoue et l'IP détectée est
# remontée dans l'erreur). En local, expose le webhook via ngrok.
CINETPAY_NOTIFY_URL=http://localhost:4000/api/v1/payments/cinetpay/webhook
CINETPAY_RETURN_URL=http://localhost:5173/wallet
# Notification des TRANSFERTS (versement des retraits). Route distincte de celle
# des encaissements : corps et machine à états différents.
CINETPAY_PAYOUT_NOTIFY_URL=http://localhost:4000/api/v1/payments/cinetpay/payout/webhook
# Alerte quand le solde marchand d'un pays passe sous ce seuil (devise locale).
# 0 = surveillance désactivée. Un compte à sec fait échouer tous les transferts.
CINETPAY_BALANCE_ALERT_THRESHOLD=0

# --- Payments: Moneroo -------------------------------------------------------
MONEROO_SECRET_KEY=
MONEROO_WEBHOOK_SECRET=

# --- Payments: Stripe --------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=

# --- Storage ----------------------------------------------------------------
# Pilote de stockage des médias : "s3" (Cloudflare R2 / AWS S3, recommandé en
# prod) ou "local" (disque du backend, servi via /media — pratique en dev, mais
# éphémère sur la plupart des hébergeurs). Voir docs/STORAGE.md.
STORAGE_DRIVER=s3
# Driver local uniquement :
LOCAL_STORAGE_DIR=storage/uploads
# URL publique de base pour les médias locaux (repli sur API_BASE_URL/media si vide)
LOCAL_PUBLIC_BASE_URL=

# --- Storage : S3 / Cloudflare R2 (si STORAGE_DRIVER=s3) ---------------------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=duel-music
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_PRESIGN_EXPIRES_SECONDS=900

# --- Antivirus (optional ClamAV clamd hook for upload confirmation) ----------
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=8000

# --- Email (SMTP / Resend) ---------------------------------------------------
MAIL_FROM="Dual Music <no-reply@dualmusic.app>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
RESEND_API_KEY=

# --- Web Push (VAPID) --------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dualmusic.app

# --- Economy -----------------------------------------------------------------
# 1 credit = 0.50 EUR (business invariant).
CREDIT_EUR_VALUE=0.5
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/EUR
