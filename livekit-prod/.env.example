# Copier en `.env` dans CE dossier (jamais committé) avant `docker compose up -d`.

# Clé/secret API LiveKit de PRODUCTION (secret ≥ 32 caractères, aléatoire) :
#   openssl rand -hex 24
# Les MÊMES valeurs vont dans le .env du backend (LIVEKIT_API_KEY / LIVEKIT_API_SECRET).
LIVEKIT_API_KEY=dualmusic_prod
LIVEKIT_API_SECRET=

# Sous-domaine TURN (enregistrement DNS A → IP du VPS) avec certificat Let's Encrypt
# dans /etc/letsencrypt/live/<TURN_DOMAIN>/ (voir le guide).
TURN_DOMAIN=turn.dualmusic.pro
